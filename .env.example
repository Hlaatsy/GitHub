# Copy to .env and fill in. .env is gitignored -- never commit real values.

# From https://www.linkedin.com/developers/apps -> your app -> Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must also be listed as an authorized redirect URL on the app.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# openid and profile identify the account; w_member_social allows posting.
# Posting as a company page instead needs w_organization_social, which
# requires LinkedIn to approve your app for the Community Management API.
LINKEDIN_SCOPES=openid profile w_member_social

# Produced by `python -m linkedin.auth`. Expires in about 60 days.
LINKEDIN_ACCESS_TOKEN=

# Optional. Defaults to the token holder's own profile.
# Company page form: urn:li:organization:12345678
LINKEDIN_AUTHOR_URN=

# Optional. LinkedIn's monthly API version; bump on a 426 response.
LINKEDIN_VERSION=202505
