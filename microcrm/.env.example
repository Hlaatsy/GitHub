NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# docker-compose builds DATABASE_URL from these; set DATABASE_URL directly when running outside Docker.
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=whatsapp_crm
DATABASE_URL=postgresql://crm_user:replace-me@localhost:5432/whatsapp_crm?schema=public

# Meta WhatsApp Business Cloud API (Graph API v20.0 or newer)
WA_GRAPH_BASE_URL=https://graph.facebook.com
WA_GRAPH_VERSION=v20.0
WA_ACCESS_TOKEN=replace-with-system-user-token
WA_APP_SECRET=replace-with-meta-app-secret
WA_VERIFY_TOKEN=replace-with-a-long-random-string
WA_HTTP_TIMEOUT_MS=8000
# Read receipts cost no Meta fee but add one Graph call per inbound message.
WA_MARK_AS_READ=false
WA_LOW_BALANCE_TEMPLATE=wallet_low_balance
WA_TEMPLATE_LANGUAGE=en

# Wallet debits per outbound message, in ZAR cents.
COST_SERVICE_MESSAGE_CENTS=12
COST_UTILITY_TEMPLATE_CENTS=12

# Cost guards
MENU_COOLDOWN_SECONDS=300
STALE_MESSAGE_SECONDS=3600
CUSTOMER_MAX_EVENTS_PER_MINUTE=6

# Payments (Ozow pay-by-bank). Leave the three OZOW secrets empty to disable.
PUBLIC_BASE_URL=https://yourdomain.co.za
OZOW_SITE_CODE=
OZOW_API_KEY=
OZOW_PRIVATE_KEY=
# Staging: https://stagingapi.ozow.com with OZOW_IS_TEST=true (refused when NODE_ENV=production).
OZOW_BASE_URL=https://api.ozow.com
OZOW_IS_TEST=false
OZOW_TIMEOUT_MS=10000
PAYMENT_LINK_TTL_MINUTES=30
PAYMENT_MAX_CENTS=5000000
PAYMENT_RECONCILE_INTERVAL_SECONDS=120
# Comma-separated provider egress IPs; empty disables the allowlist.
PAYMENT_WEBHOOK_ALLOWED_IPS=
WA_PAYMENT_REQUEST_TEMPLATE=payment_request
WA_PAYMENT_CONFIRMED_TEMPLATE=payment_confirmed

# SMS fallback (BulkSMS): re-sends a pay link by SMS when WhatsApp reports it
# undeliverable (error 131026). Needs payments enabled. Leave both empty to disable.
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
BULKSMS_BASE_URL=https://api.bulksms.com/v1
# Registered alphanumeric sender ID, max 11 characters; empty uses BulkSMS's default route.
BULKSMS_SENDER_ID=
SMS_TIMEOUT_MS=8000
# Wallet charge per SMS segment (160 GSM-7 / 70 Unicode characters), in cents.
SMS_COST_PER_SEGMENT_CENTS=25
