NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# docker-compose builds DATABASE_URL from these; set DATABASE_URL directly when running outside Docker.
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=whatsapp_crm
DATABASE_URL=postgresql://crm_user:replace-me@localhost:5432/whatsapp_crm?schema=public

# Meta WhatsApp Business Cloud API (Graph API v20.0 or newer)
WA_GRAPH_BASE_URL=https://graph.facebook.com
WA_GRAPH_VERSION=v20.0
WA_ACCESS_TOKEN=replace-with-system-user-token
WA_APP_SECRET=replace-with-meta-app-secret
WA_VERIFY_TOKEN=replace-with-a-long-random-string
WA_HTTP_TIMEOUT_MS=8000
# Read receipts cost no Meta fee but add one Graph call per inbound message.
WA_MARK_AS_READ=false
WA_LOW_BALANCE_TEMPLATE=wallet_low_balance
WA_TEMPLATE_LANGUAGE=en

# Wallet debits per outbound message, in ZAR cents.
COST_SERVICE_MESSAGE_CENTS=12
COST_UTILITY_TEMPLATE_CENTS=12

# Cost guards
MENU_COOLDOWN_SECONDS=300
STALE_MESSAGE_SECONDS=3600
CUSTOMER_MAX_EVENTS_PER_MINUTE=15

# Payments. Configure any of Ozow, PayFast and Paystack; each is all-or-nothing.
# New payment links use PAYMENT_DEFAULT_PROVIDER (or the first configured), unless a
# business sets "paymentProvider" in its config file.
PAYMENT_DEFAULT_PROVIDER=

# Ozow pay-by-bank. Settles at /webhooks/payments (sent with each payment).
PUBLIC_BASE_URL=https://yourdomain.co.za
OZOW_SITE_CODE=
OZOW_API_KEY=
OZOW_PRIVATE_KEY=
# Staging: https://stagingapi.ozow.com with OZOW_IS_TEST=true (refused when NODE_ENV=production).
OZOW_BASE_URL=https://api.ozow.com
OZOW_IS_TEST=false
OZOW_TIMEOUT_MS=10000
PAYMENT_LINK_TTL_MINUTES=30
PAYMENT_MAX_CENTS=5000000
PAYMENT_RECONCILE_INTERVAL_SECONDS=120
# Comma-separated provider egress IPs; empty disables the allowlist.
PAYMENT_WEBHOOK_ALLOWED_IPS=
WA_PAYMENT_REQUEST_TEMPLATE=payment_request
WA_PAYMENT_CONFIRMED_TEMPLATE=payment_confirmed

# SMS fallback (BulkSMS): re-sends a pay link by SMS when WhatsApp reports it
# undeliverable (error 131026). Needs payments enabled. Leave both empty to disable.
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
BULKSMS_BASE_URL=https://api.bulksms.com/v1
# Registered alphanumeric sender ID, max 11 characters; empty uses BulkSMS's default route.
BULKSMS_SENDER_ID=
SMS_TIMEOUT_MS=8000
# Wallet charge per SMS segment (160 GSM-7 / 70 Unicode characters), in cents.
SMS_COST_PER_SEGMENT_CENTS=25

# Owner onboarding checklist (/onboarding/<token>, issued with `admin onboarding-link`).
# Real payment the owner makes to their own WhatsApp to prove the flow, in cents.
ONBOARDING_TEST_AMOUNT_CENTS=500
ONBOARDING_LINK_TTL_HOURS=168

# Owner dashboard at https://<domain>/dashboard/. Owners log in by sending LOGIN
# to their business WhatsApp number from the owner phone on file.
DASHBOARD_LOGIN_LINK_MINUTES=10
DASHBOARD_SESSION_HOURS=12
DASHBOARD_IDLE_MINUTES=60
DASHBOARD_MAX_LINKS_PER_HOUR=5

# Each business can be paid into its OWN PayFast or Paystack account
# (admin payment-account-set). Their keys are encrypted with this key.
# Generate once with `openssl rand -base64 32` (deploy.sh does this) and never
# change it: stored accounts become unreadable. Back it up with the .env.
CREDENTIALS_ENCRYPTION_KEY=

# Your POPIA privacy notice (template: docs/privacy-notice.md), linked from
# each customer's first menu message.
PRIVACY_NOTICE_URL=

# Platform-wide PayFast / Paystack accounts below are optional fallbacks for
# businesses without their own. Leave empty if every business brings its own.

# PayFast (cards, EFT). Settles at /api/payments/payfast-itn (sent with each payment).
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Set the same passphrase in PayFast: Settings > Developer settings.
PAYFAST_PASSPHRASE=
# Sandbox: true for testing (refused when NODE_ENV=production).
PAYFAST_SANDBOX=false
PAYFAST_VERIFY_SOURCE_IP=true
PAYFAST_TIMEOUT_MS=10000

# Paystack (cards, Capitec Pay). Set the webhook URL in the Paystack dashboard
# (Settings > API Keys & Webhooks) to https://<domain>/api/payments/callback.
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_TIMEOUT_MS=10000
# Optional: Paystack's webhook source IPs, comma-separated. The HMAC signature is always checked.
PAYSTACK_WEBHOOK_ALLOWED_IPS=
# Paystack requires a customer email. Each payment gets pay-<reference>@<this domain>.
PAYSTACK_PLACEHOLDER_EMAIL_DOMAIN=

