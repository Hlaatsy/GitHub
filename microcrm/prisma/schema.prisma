// Multi-tenant WhatsApp micro-CRM.
//
// Isolation: every tenant-owned row carries `tenantId`, and cross-table
// references use composite foreign keys on (tenantId, id). The database itself
// therefore rejects an appointment or order that points at another tenant's
// customer, service or product, even if application code gets a query wrong.
//
// POPIA: only the minimum personal information needed to respond and fulfil
// bookings is stored (WhatsApp ID, profile name). Message bodies are never
// persisted. Deleting a tenant cascades to all of its customers' data.
//
// Money: all amounts are integer ZAR cents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IndustryType {
  SALON
  DECOR_HIRE
  PRODUCT_SELLER
}

enum AppointmentStatus {
  PENDING
  /// Slot held until `holdExpiresAt` while the customer pays a deposit.
  PENDING_DEPOSIT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum OrderStatus {
  PENDING
  PENDING_DEPOSIT
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum WalletTransactionType {
  TOP_UP
  MESSAGE_DEBIT
  ADJUSTMENT
}

enum PaymentProvider {
  OZOW
  PAYFAST
  PAYSTACK
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum MessageCategory {
  SERVICE
  UTILITY
  /// Fallback text message; `wamid` then holds the SMS provider's message id.
  SMS
}

model Tenant {
  id                   String       @id @default(uuid()) @db.Uuid
  businessName         String       @db.VarChar(120)
  industry             IndustryType
  /// Meta `phone_number_id`: every inbound webhook is resolved to a tenant by this value.
  waPhoneNumberId      String       @unique @db.VarChar(32)
  waDisplayPhone       String       @db.VarChar(20)
  /// WhatsApp Business Account that owns the number; message templates are approved per WABA.
  waBusinessAccountId  String?      @db.VarChar(32)
  /// Owner's WhatsApp ID (digits only) for wallet top-up alerts.
  ownerWaId            String?      @db.VarChar(15)
  /// Meta Commerce catalog linked to the WABA; enables `product_list` messages.
  metaCatalogId        String?      @db.VarChar(32)

  currency             String       @default("ZAR") @db.Char(3)
  vatRegistered        Boolean      @default(false)
  vatRateBps           Int          @default(1500)
  pricesIncludeVat     Boolean      @default(true)

  timezone             String       @default("Africa/Johannesburg") @db.VarChar(64)
  /// { "mon": [{ "open": "08:00", "close": "17:00" }], ..., "sun": [] }
  workingHours         Json
  slotIntervalMinutes  Int          @default(30)
  defaultSlotMinutes   Int          @default(60)
  /// Concurrent bookings per slot (e.g. number of chairs).
  bookingCapacity      Int          @default(1)
  minLeadMinutes       Int          @default(60)
  autoConfirmBookings  Boolean      @default(false)
  /// Share of the total collected upfront via pay-by-bank, in basis points.
  /// 0 disables payments; 10000 collects the full amount.
  depositBps           Int          @default(0)
  /// Gateway for this business's new payment links; null uses the platform default.
  paymentProvider      PaymentProvider?

  addressLine          String?      @db.VarChar(200)
  mapsUrl              String?      @db.VarChar(500)
  /// Inbound media is never downloaded unless the tenant opts in.
  mediaDownloadEnabled Boolean      @default(false)
  active               Boolean      @default(true)
  /// SHA-256 of the owner's onboarding link token; the token itself is never stored.
  onboardingTokenHash      String?   @unique @db.Char(64)
  onboardingTokenExpiresAt DateTime? @db.Timestamptz(3)

  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)

  wallet               TenantWallet?
  walletTransactions   WalletTransaction[]
  customers            Customer[]
  services             Service[]
  products             Product[]
  appointments         Appointment[]
  orders               Order[]
  orderItems           OrderItem[]
  inboundMessages      InboundMessage[]
  outboundMessages     OutboundMessage[]
  paymentIntents       PaymentIntent[]
  dashboardLoginTokens DashboardLoginToken[]
  dashboardSessions    DashboardSession[]

  @@map("tenants")
}

model Customer {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  /// WhatsApp ID: E.164 digits without '+', e.g. 27821234567.
  waId               String    @db.VarChar(15)
  displayName        String?   @db.VarChar(80)
  /// Lawful-basis evidence: the data subject initiated contact on this date.
  firstContactAt     DateTime  @default(now()) @db.Timestamptz(3)
  /// POPIA s69: electronic direct marketing requires opt-in. Null means none.
  marketingConsentAt DateTime? @db.Timestamptz(3)
  optedOutAt         DateTime? @db.Timestamptz(3)
  lastInboundAt      DateTime? @db.Timestamptz(3)
  lastMenuSentAt     DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments       Appointment[]
  orders             Order[]
  outboundMessages   OutboundMessage[]
  paymentIntents     PaymentIntent[]

  @@unique([tenantId, waId])
  @@unique([tenantId, id])
  @@map("customers")
}

model Service {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  name            String   @db.VarChar(60)
  durationMinutes Int
  priceCents      Int
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@unique([tenantId, id])
  @@index([tenantId, active, sortOrder])
  @@map("services")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  name           String   @db.VarChar(60)
  description    String?  @db.VarChar(200)
  priceCents     Int
  /// Shown after the price, e.g. "per day" for decor hire.
  priceUnit      String?  @db.VarChar(20)
  /// `retailer_id` of the matching item in the Meta catalog.
  metaRetailerId String?  @db.VarChar(100)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, metaRetailerId])
  @@index([tenantId, active, sortOrder])
  @@map("products")
}

model Appointment {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @db.Uuid
  customerId String            @db.Uuid
  serviceId  String?           @db.Uuid
  status     AppointmentStatus @default(PENDING)
  startsAt   DateTime          @db.Timestamptz(3)
  endsAt     DateTime          @db.Timestamptz(3)
  totalCents Int               @default(0)
  /// While PENDING_DEPOSIT, the slot only counts as taken until this instant.
  holdExpiresAt DateTime?      @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  service    Service? @relation(fields: [tenantId, serviceId], references: [tenantId, id], onDelete: Restrict)
  paymentIntents PaymentIntent[]

  @@unique([tenantId, id])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, customerId])
  @@map("appointments")
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  customerId String      @db.Uuid
  /// Short human-friendly reference quoted to the customer.
  reference  String      @db.VarChar(12)
  status     OrderStatus @default(PENDING)
  totalCents Int
  /// Owner's onboarding test payment: exclude from revenue and fulfilment.
  isTest     Boolean     @default(false)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer    @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  items      OrderItem[]
  paymentIntents PaymentIntent[]

  @@unique([tenantId, reference])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  tenantId       String @db.Uuid
  orderId        String @db.Uuid
  productId      String @db.Uuid
  quantity       Int
  unitPriceCents Int

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order          Order   @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  product        Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@map("order_items")
}

/// Prepaid ZAR balance that funds the tenant's WhatsApp message costs.
model TenantWallet {
  tenantId                 String    @id @db.Uuid
  balanceCents             Int       @default(0)
  lowBalanceThresholdCents Int       @default(1000)
  /// Last top-up warning sent to the owner; reset by a top-up above threshold.
  lowBalanceNotifiedAt     DateTime? @db.Timestamptz(3)
  updatedAt                DateTime  @updatedAt @db.Timestamptz(3)

  tenant                   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_wallets")
}

/// Append-only ledger. Unique `outboundMessageId` makes a message debit idempotent.
model WalletTransaction {
  id                String                @id @default(uuid()) @db.Uuid
  tenantId          String                @db.Uuid
  type              WalletTransactionType
  /// Signed: positive for top-ups, negative for debits.
  amountCents       Int
  balanceAfterCents Int
  outboundMessageId String?               @unique @db.Uuid
  reference         String?               @db.VarChar(64)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outboundMessage   OutboundMessage? @relation(fields: [outboundMessageId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@map("wallet_transactions")
}

/// Idempotency ledger for Meta webhook redeliveries. Holds no message content;
/// prune rows older than 30 days (see pruneInboundLedger).
model InboundMessage {
  wamid       String   @id @db.VarChar(128)
  tenantId    String   @db.Uuid
  messageType String   @db.VarChar(24)
  receivedAt  DateTime @default(now()) @db.Timestamptz(3)

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([receivedAt])
  @@map("inbound_messages")
}

/// Cost log of every message sent. Holds no message content.
model OutboundMessage {
  id         String          @id @default(uuid()) @db.Uuid
  tenantId   String          @db.Uuid
  customerId String?         @db.Uuid
  wamid      String          @unique @db.VarChar(128)
  category   MessageCategory
  /// e.g. "interactive:button", "interactive:list", "text", "template:wallet_low_balance"
  kind       String          @db.VarChar(64)
  costCents  Int
  inReplyTo  String?         @db.VarChar(128)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  walletTransaction  WalletTransaction?

  @@index([tenantId, createdAt])
  @@map("outbound_messages")
}

/// One pay-by-bank attempt for exactly one appointment or order (enforced by
/// a CHECK constraint in the migration). Holds no bank or card details: the
/// customer pays on the provider's hosted page.
model PaymentIntent {
  id                    String          @id @default(uuid()) @db.Uuid
  tenantId              String          @db.Uuid
  customerId            String          @db.Uuid
  appointmentId         String?         @db.Uuid
  orderId               String?         @db.Uuid
  provider              PaymentProvider
  /// Our merchant reference sent to the provider; echoed back in notifications.
  reference             String          @unique @db.VarChar(50)
  /// Unguessable token behind the short link https://<domain>/pay/<token>.
  linkToken             String          @unique @db.VarChar(64)
  amountCents           Int
  currency              String          @default("ZAR") @db.Char(3)
  status                PaymentStatus   @default(PENDING)
  providerPaymentId     String?         @db.VarChar(100)
  providerTransactionId String?         @db.VarChar(100)
  checkoutUrl           String?         @db.VarChar(1000)
  /// Signed form fields when the checkout is a browser form POST (PayFast) rather than a redirect.
  checkoutFields        Json?
  expiresAt             DateTime        @db.Timestamptz(3)
  settledAt             DateTime?       @db.Timestamptz(3)
  /// Set when the confirmation template went out; the reconciler retries until it is.
  customerNotifiedAt    DateTime?       @db.Timestamptz(3)
  /// WhatsApp message that carried the pay link; Meta's delivery statuses refer to it.
  payLinkWamid          String?         @unique @db.VarChar(128)
  /// Claimed before the SMS fallback is sent, so a re-delivered status cannot send a second one.
  smsFallbackSentAt     DateTime?       @db.Timestamptz(3)
  /// Paid, but needs a human: e.g. the booking was cancelled or the slot overbooked meanwhile.
  reviewRequired        Boolean         @default(false)
  failureReason         String?         @db.VarChar(200)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer     @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Restrict)
  order       Order?       @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([tenantId, appointmentId])
  @@index([tenantId, orderId])
  @@map("payment_intents")
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  IN_APPEAL
  /// Any status Meta adds later; treated as not sendable.
  OTHER
}

/// Meta's approval state for a message template in one WhatsApp Business Account.
/// Rows are created by submission/sync only; status webhooks update existing rows.
model MessageTemplate {
  id                String         @id @default(uuid()) @db.Uuid
  wabaId            String         @db.VarChar(32)
  name              String         @db.VarChar(512)
  language          String         @db.VarChar(15)
  /// What we asked for.
  requestedCategory String         @db.VarChar(20)
  /// What Meta assigned. MARKETING costs more than UTILITY, so a change is flagged.
  category          String         @db.VarChar(20)
  status            TemplateStatus
  metaTemplateId    String?        @db.VarChar(32)
  rejectedReason    String?        @db.VarChar(200)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([wabaId, name, language])
  @@map("message_templates")
}

/// Single-use dashboard login link, sent only to the owner's own WhatsApp. Only the token's hash is stored.
model DashboardLoginToken {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("dashboard_login_tokens")
}

/// Owner dashboard session behind an HttpOnly cookie. Only the cookie value's hash is stored.
model DashboardSession {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("dashboard_sessions")
}
