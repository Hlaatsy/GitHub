# Copy to .env and fill in. .env is gitignored -- never commit real values.

# From https://www.linkedin.com/developers/apps -> your app -> Auth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must also be listed as an authorized redirect URL on the app.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# Posting as the KhutsoGRC company page needs w_organization_social, which
# only comes with Community Management API approval. Until that is granted,
# swap in the member-only line below to post as yourself.
LINKEDIN_SCOPES=openid profile w_organization_social rw_organization_admin
# LINKEDIN_SCOPES=openid profile w_member_social

# Produced by `python -m linkedin.auth`. Expires in about 60 days.
LINKEDIN_ACCESS_TOKEN=

# KhutsoGRC company page, from the admin dashboard URL:
# linkedin.com/company/145207663/admin/ -> urn:li:organization:145207663
# Confirm with `python -m linkedin pages`. Unset posts as the token holder.
LINKEDIN_AUTHOR_URN=urn:li:organization:145207663

# Agreed 60-day run window, matching the token's lifetime. Once this
# passes, `publish` pauses instead of posting, so the schedule stops on its
# own rather than drifting on unreviewed. Extend the date or clear the line
# to resume.
LINKEDIN_SCHEDULE_ENDS_AT=2026-11-18T00:00:00Z

# Recorded by `python -m linkedin.auth` alongside the token.
LINKEDIN_TOKEN_EXPIRES_AT=

# Optional. LinkedIn's monthly API version; bump on a 426 response.
LINKEDIN_VERSION=202505
