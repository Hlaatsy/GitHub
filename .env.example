# Kinnect environment variables
# Copy this file to .env.local and fill in values from your Supabase project.
# NEVER commit .env.local or real keys.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. Safe for the browser — protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY. Bypasses RLS — never expose to the browser,
# never prefix with NEXT_PUBLIC_. Not required for Phase 1.
# SUPABASE_SERVICE_ROLE_KEY=
