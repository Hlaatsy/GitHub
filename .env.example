# ---------------------------------------------------------------- Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role. Bypasses RLS -- server only, never in a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ------------------------------------------------------------------- site
NEXT_PUBLIC_SITE_URL=https://swiftinbox.co.za

# -------------------------------------------------------- WhatsApp Cloud API
# Token you choose; paste the same string into Meta's webhook setup screen.
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta. Without it every webhook POST is rejected, which is
# the safe direction: an unsigned request must never be treated as real.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# -------------------------------------------------------------------- Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --------------------------------------------------------------------- n8n
# Optional. Unset means the webhook answers with Groq directly.
N8N_WEBHOOK_URL=
N8N_SHARED_SECRET=

# ---------------------------------------------------------------- Paystack
PAYSTACK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_...
# Plan codes created in the Paystack dashboard, in ZAR, monthly.
PAYSTACK_PLAN_STARTER=PLN_...
PAYSTACK_PLAN_BASIC=PLN_...
PAYSTACK_PLAN_GROWTH=PLN_...
PAYSTACK_PLAN_SCALE=PLN_...
